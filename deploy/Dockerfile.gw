# Build stage: openvenice frontend (public repo Ant-Apex/openvenice).
# Baked into the image so the attested digest covers the served frontend bytes.
FROM node:22-bookworm AS frontend
ARG OV_REF=master
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
ADD "https://github.com/Ant-Apex/openvenice/archive/${OV_REF}.tar.gz" /tmp/ov.tar.gz
RUN mkdir -p /src && tar xzf /tmp/ov.tar.gz -C /src --strip-components=1
WORKDIR /src
RUN npm ci && npm run build

FROM node:22-bookworm
WORKDIR /app
ENV NODE_ENV=production
COPY gw/package.json gw/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force && mkdir -p /data-gw
COPY gw/main.mjs ./
COPY --from=frontend /src/dist /srv/chat
EXPOSE 8420
CMD ["node", "main.mjs"]
